{
    "name": "riskfortress-intelligence",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build && node scripts/patch-routes.js",
        "start": "next start",
        "lint": "next lint",
        "format": "prettier --write .",
        "test": "jest --coverage",
        "test:e2e": "playwright test",
        "test:ci": "jest --ci --coverage",
        "security:audit": "npm audit --production",
        "security:scan": "snyk test",
        "prepare": "node -e \"try { require('husky')() } catch (e) { if (e.code !== 'MODULE_NOT_FOUND') throw e }\"",
        "type-check": "tsc --noEmit",
        "analyze": "ANALYZE=true next build",
        "generate-sitemap": "tsx src/scripts/generate-sitemap.ts",
        "generate-og": "tsx src/scripts/generate-og.ts",
        "build:cloudflare": "node build-cloudflare.js",
        "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy .next --project-name=riskfortress",
        "deploy:staging": "NEXT_PUBLIC_APP_URL=https://staging.riskfortress.in npm run build:cloudflare && wrangler pages deploy .next --project-name=riskfortress-staging"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.3.4",
        "@tiptap/extension-color": "^3.20.0",
        "@tiptap/extension-font-family": "^3.20.0",
        "@tiptap/extension-heading": "^3.20.0",
        "@tiptap/extension-highlight": "^3.20.0",
        "@tiptap/extension-image": "^3.20.0",
        "@tiptap/extension-link": "^3.20.0",
        "@tiptap/extension-placeholder": "^3.20.0",
        "@tiptap/extension-subscript": "^3.20.0",
        "@tiptap/extension-superscript": "^3.20.0",
        "@tiptap/extension-table": "^3.20.0",
        "@tiptap/extension-table-cell": "^3.20.0",
        "@tiptap/extension-table-header": "^3.20.0",
        "@tiptap/extension-table-row": "^3.20.0",
        "@tiptap/extension-task-item": "^3.20.0",
        "@tiptap/extension-task-list": "^3.20.0",
        "@tiptap/extension-text-align": "^3.20.0",
        "@tiptap/extension-text-style": "^3.20.0",
        "@tiptap/extension-underline": "^3.20.0",
        "@tiptap/pm": "^3.20.0",
        "@tiptap/react": "^3.20.0",
        "@tiptap/starter-kit": "^3.20.0",
        "@types/node": "20.11.5",
        "@types/react": "18.2.47",
        "@types/react-dom": "18.2.18",
        "@types/react-reconciler": "^0.32.3",
        "@types/webxr": "^0.5.24",
        "@upstash/ratelimit": "2.0.8",
        "@upstash/redis": "^1.36.2",
        "@vercel/analytics": "1.6.1",
        "@vercel/og": "0.8.6",
        "@vercel/speed-insights": "1.3.1",
        "autoprefixer": "10.4.24",
        "clsx": "2.1.1",
        "critters": "^0.0.25",
        "crypto-js": "4.2.0",
        "cssnano": "^7.1.2",
        "date-fns": "3.3.1",
        "firebase": "^12.9.0",
        "framer-motion": "10.16.16",
        "lucide-react": "0.575.0",
        "next": "^16.1.1",
        "next-seo": "6.5.0",
        "next-sitemap": "4.2.3",
        "next-themes": "0.4.6",
        "postcss": "8.5.6",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-hook-form": "7.71.2",
        "recharts": "2.10.3",
        "sharp": "0.34.5",
        "sonner": "1.4.1",
        "tailwind-merge": "2.2.0",
        "tailwindcss": "3.4.1",
        "typescript": "5.3.3",
        "zod": "3.22.4"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260228.0",
        "@playwright/test": "^1.58.2",
        "@svgr/webpack": "8.1.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@typescript-eslint/eslint-plugin": "6.19.0",
        "@typescript-eslint/parser": "6.19.0",
        "eslint": "8.56.0",
        "eslint-config-next": "14.0.4",
        "husky": "9.1.7",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "lint-staged": "^15.5.2",
        "prettier": "3.8.1",
        "snyk": "^1.1302.0",
        "ts-jest": "29.4.6",
        "tsx": "^4.21.0",
        "webpack-bundle-analyzer": "4.10.1"
    },
    "engines": {
        "node": ">=18.17.0",
        "npm": ">=9.0.0"
    }
}
